// Digital Invitation SaaS — Prisma schema
// Source of truth: docs/DATABASE.md
// Do not add fields here that are not justified by that document.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum EventMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum EventType {
  WEDDING
  ENGAGEMENT
  BIRTHDAY
  AQIQAH
  ANNIVERSARY
  GATHERING
  CORPORATE
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GuestCategory {
  FAMILY
  FRIEND
  COLLEAGUE
  VIP
  OTHER
}

enum GuestInvitationStatus {
  NOT_SENT
  SENT
  OPENED
  RSVPED
  CHECKED_IN
}

enum RSVPAttendance {
  ATTENDING
  NOT_ATTENDING
  MAYBE
}

enum WishStatus {
  PENDING
  APPROVED
  HIDDEN
  DELETED
}

enum GiftMethodType {
  BANK
  EWALLET
  QR
  OTHER
}

enum GiftTransactionStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum GalleryItemType {
  IMAGE
  VIDEO
}

enum GiftReservationStatus {
  RESERVED
  CANCELLED
  PURCHASED
}

enum CheckInMethod {
  QR
  MANUAL
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?
  avatarUrl       String?
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownedEvents       Event[]        @relation("EventOwner")
  eventMemberships  EventMember[]
  subscriptions     Subscription[]
  payments          Payment[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  checkInsPerformed CheckIn[]      @relation("CheckedInByUser")
}

// ---------------------------------------------------------------------------
// Event core
// ---------------------------------------------------------------------------

model Event {
  id          String      @id @default(cuid())
  ownerId     String
  type        EventType
  title       String
  slug        String      @unique
  status      EventStatus @default(DRAFT)
  description String?
  templateId  String?
  publishedAt DateTime?
  expiresAt   DateTime?
  settings    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner    User      @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  members          EventMember[]
  guests           Guest[]
  guestInvitations GuestInvitation[]
  schedules        EventSchedule[]
  venues           Venue[]
  galleries        Gallery[]
  loveStories      LoveStory[]
  rsvps            RSVP[]
  wishes           Wish[]
  giftMethods      GiftMethod[]
  giftTransactions GiftTransaction[]
  giftRegistries   GiftRegistry[]
  invitationViews  InvitationView[]
  checkIns         CheckIn[]
  theme            Theme?
  weddingProfile   WeddingProfile?

  @@index([ownerId])
  @@index([status])
}

model EventMember {
  id        String          @id @default(cuid())
  eventId   String
  userId    String
  role      EventMemberRole
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ---------------------------------------------------------------------------
// Template & Theme
// ---------------------------------------------------------------------------

model Template {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  category        String?
  previewImageUrl String?
  isActive        Boolean  @default(true)
  isPremium       Boolean  @default(false)
  configuration   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events Event[]
}

model Theme {
  id                 String   @id @default(cuid())
  eventId            String   @unique
  primaryColor       String?
  secondaryColor     String?
  backgroundColor    String?
  textColor          String?
  accentColor        String?
  headingFont        String?
  bodyFont           String?
  scriptFont         String?
  backgroundImageUrl String?
  configuration      Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Guests
// ---------------------------------------------------------------------------

model Guest {
  id             String        @id @default(cuid())
  eventId        String
  name           String
  normalizedName String
  phone          String?
  email          String?
  category       GuestCategory @default(OTHER)
  seatQuota      Int           @default(1)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  invitations      GuestInvitation[]
  rsvps             RSVP[]
  wishes           Wish[]
  checkIns         CheckIn[]
  giftTransactions GiftTransaction[]
  giftReservations GiftReservation[]
  invitationViews  InvitationView[]

  @@index([eventId])
  @@index([eventId, normalizedName])
  @@index([eventId, phone])
}

model GuestInvitation {
  id        String                 @id @default(cuid())
  eventId   String
  guestId   String
  token     String                 @unique
  status    GuestInvitationStatus  @default(NOT_SENT)
  sentAt    DateTime?
  openedAt  DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  // `eventId` previously had no enforced relation to Event — only `guestId`
  // was FK-backed. That left the event scoping of a guest token resting on
  // an unenforced scalar, which is exactly the kind of gap that could let
  // application code accidentally mismatch a token to the wrong event.
  // Added as part of Phase 3 (public/personalized invitation lookup),
  // where a token's event scope is a security boundary, not just data
  // shape. See docs/DECISIONS.md D-020.
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([eventId, guestId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Event data
// ---------------------------------------------------------------------------

model EventSchedule {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  date        DateTime @db.Date
  startTime   DateTime @db.Time
  endTime     DateTime @db.Time
  venueId     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([eventId])
}

model Venue {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  address   String
  latitude  Float?
  longitude Float?
  mapUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  schedules EventSchedule[]

  @@index([eventId])
}

model Gallery {
  id        String   @id @default(cuid())
  eventId   String
  title     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items GalleryItem[]

  @@index([eventId])
}

model GalleryItem {
  id           String          @id @default(cuid())
  galleryId    String
  type         GalleryItemType @default(IMAGE)
  url          String
  thumbnailUrl String?
  caption      String?
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId])
}

model LoveStory {
  id        String   @id @default(cuid())
  eventId   String
  title     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items LoveStoryItem[]

  @@index([eventId])
}

model LoveStoryItem {
  id          String   @id @default(cuid())
  loveStoryId String
  dateLabel   String?
  title       String
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  loveStory LoveStory @relation(fields: [loveStoryId], references: [id], onDelete: Cascade)

  @@index([loveStoryId])
}

// ---------------------------------------------------------------------------
// RSVP, wishes, check-in
// ---------------------------------------------------------------------------

model RSVP {
  id            String         @id @default(cuid())
  eventId       String
  guestId       String
  attendance    RSVPAttendance
  attendeeCount Int            @default(1)
  message       String?
  submittedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([eventId, guestId])
  @@index([eventId])
}

model Wish {
  id        String     @id @default(cuid())
  eventId   String
  guestId   String
  name      String
  message   String
  status    WishStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
}

model CheckIn {
  id            String        @id @default(cuid())
  eventId       String
  guestId       String
  checkedInAt   DateTime      @default(now())
  checkedInBy   String?
  method        CheckInMethod @default(MANUAL)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  event           Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest           Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  checkedInByUser User? @relation("CheckedInByUser", fields: [checkedInBy], references: [id], onDelete: SetNull)

  @@unique([eventId, guestId])
}

// ---------------------------------------------------------------------------
// Gifting
// ---------------------------------------------------------------------------

model GiftMethod {
  id            String         @id @default(cuid())
  eventId       String
  type          GiftMethodType
  providerName  String?
  accountName   String?
  accountNumber String?
  qrImageUrl    String?
  instructions  String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model GiftTransaction {
  id                    String                 @id @default(cuid())
  eventId               String
  guestId               String
  provider              String
  providerTransactionId String?
  amount                Decimal                @db.Decimal(14, 2)
  currency              String                 @default("IDR")
  status                GiftTransactionStatus  @default(PENDING)
  paidAt                DateTime?
  metadata              Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Financial records: never cascade-delete with their event/guest.
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@index([guestId])
}

model GiftRegistry {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items GiftItem[]

  @@index([eventId])
}

model GiftItem {
  id          String   @id @default(cuid())
  registryId  String
  name        String
  description String?
  imageUrl    String?
  price       Decimal? @db.Decimal(14, 2)
  url         String?
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registry     GiftRegistry      @relation(fields: [registryId], references: [id], onDelete: Cascade)
  reservations GiftReservation[]

  @@index([registryId])
}

model GiftReservation {
  id         String                @id @default(cuid())
  giftItemId String
  guestId    String
  quantity   Int                   @default(1)
  status     GiftReservationStatus @default(RESERVED)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  giftItem GiftItem @relation(fields: [giftItemId], references: [id], onDelete: Cascade)
  guest    Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([giftItemId])
  @@index([guestId])
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

model InvitationView {
  id         String   @id @default(cuid())
  eventId    String
  guestId    String?
  sessionId  String
  deviceType String?
  referrer   String?
  createdAt  DateTime @default(now())

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest? @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([guestId, createdAt])
}

// ---------------------------------------------------------------------------
// Monetization
// ---------------------------------------------------------------------------

model Plan {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  price           Decimal          @db.Decimal(14, 2)
  currency        String           @default("IDR")
  billingInterval BillingInterval
  isActive        Boolean          @default(true)
  features        Json
  limits          Json
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  planId                 String
  provider               String?
  providerSubscriptionId String?
  status                 SubscriptionStatus @default(TRIALING)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  payments Payment[]

  @@index([userId])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  subscriptionId    String?
  provider          String
  providerPaymentId String?
  amount            Decimal       @db.Decimal(14, 2)
  currency          String        @default("IDR")
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Financial record: never cascade-delete with the user; detach the
  // subscription link instead of deleting the payment history.
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  maxRedemptions Int?
  redeemedCount  Int        @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Notifications & audit
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  // Audit trail: keep the row even if the acting user is deleted.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resourceType, resourceId])
}

// ---------------------------------------------------------------------------
// Event-type profiles
// ---------------------------------------------------------------------------

model WeddingProfile {
  id               String   @id @default(cuid())
  eventId          String   @unique
  brideFullName    String?
  brideNickname    String?
  brideFather      String?
  brideMother      String?
  brideInstagram   String?
  groomFullName    String?
  groomNickname    String?
  groomFather      String?
  groomMother      String?
  groomInstagram   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}
